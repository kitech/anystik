#include "davobfus.h"
#include "libobfuscate/obfuscate.h"
#include "advobfuscator/string.h"

// 双轨混淆：
//   Android / Debug / RelWithDebInfo 等同调试型构建 → libobfuscate AY_OBFUSCATE（全构建生效）
//   非 Android 的 Release 构建 → ADVobfuscator ""_obf（混淆更强）
// 注意：Android 不用 ADVobfuscator —— 该 2025 版(consteval+FSM)在 NDK clang 上
// 运行时解码抛 std::exception，进入 noexcept 触发 std::terminate 闪退（实测安卓
// 点「自动获取描述」即崩）；libobfuscate 全平台稳定，仅混淆强度低一档。
// 检测条件取四信号 OR，任一命中即回退 libobfuscate，宁保守不碰 ADVobfuscator：
//   - __ANDROID__  NDK clang 恒定义，Android 一律走稳定支
//   - _DEBUG       MSVC 传统调试宏
//   - !NDEBUG      C/C++ 标准：未定义 NDEBUG 即断言/调试模式
//   - QT_DEBUG     Qt：qtconfigmacros.h 在未定义 QT_NO_DEBUG 时自动定义
// ADVobfuscator 须用 `_obf` UDL 而非显式构造：
//   ObfuscatedString("...") 会把字面量当运行时参数留在 .rodata 泄露明文；
//   "..."_obf 把 ObfuscatedString 整体作为 NTTP 模板实参，仅存编码字节。
// 勿把 UDL 对象赋给 char*（语句结束析构），须经隐式转换 const char* 后用 QString::fromUtf8。
using namespace andrivet::advobfuscator;

// format: https://user:pass@path/dav
// user/pass 含 @ 需写成 %40
// caller parse URL
#define DAVOBFUS_KEY "AUTHKEY_PLACEHOLDER"

// Z.ai 智谱国际版 API key（stub 示例；真实值替换 ZAI_OBFUS_KEY 一处即可）
#define ZAI_OBFUS_KEY "ZAI_KEY_PLACEHOLDER"

QString davObfusKey()
{
#if defined(__ANDROID__) || defined(_DEBUG) || !defined(NDEBUG) || defined(QT_DEBUG)
    // libobfuscate：编译期 XOR 加密，明文不出现在二进制（全构建生效）
    const char* key = AY_OBFUSCATE(DAVOBFUS_KEY);
    return QString::fromUtf8(key);
#else
    // ADVobfuscator：constexpr 加密 + 运行时 FSM 解码（仅 Release 有效）
    // 不能直接 fromUtf8(key)：ObfuscatedString→QByteArrayView 需两级隐式转换，C++ 不允许；
    // 先取 const char*（一级 UDC），key 生命周期覆盖函数体，指针有效
    auto key = DAVOBFUS_KEY""_obf;
    const char* decoded = key;
    return QString::fromUtf8(decoded);
#endif
}

QString zaiApiKey()
{
#if defined(__ANDROID__) || defined(_DEBUG) || !defined(NDEBUG) || defined(QT_DEBUG)
    const char* key = AY_OBFUSCATE(ZAI_OBFUS_KEY);
    return QString::fromUtf8(key);
#else
    auto key = ZAI_OBFUS_KEY""_obf;
    const char* decoded = key;
    return QString::fromUtf8(decoded);
#endif
}