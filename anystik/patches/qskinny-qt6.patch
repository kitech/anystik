diff --git a/cmake/QskFindMacros.cmake b/cmake/QskFindMacros.cmake
index 88adb67..38010f8 100644
--- a/cmake/QskFindMacros.cmake
+++ b/cmake/QskFindMacros.cmake
@@ -9,6 +9,9 @@ macro(qsk_setup_Qt)
     # using -DCMAKE_PREFIX_PATH="..." is highly recommended
     find_package(QT "5.15" NAMES Qt6 Qt5 REQUIRED COMPONENTS Quick)
 
+    # find_package(QT NAMES ...) may not create imported targets in cross-compilation.
+    find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Core Quick)
+
     if(QT_VERSION_MAJOR VERSION_GREATER_EQUAL 6)
         # we need the qsb tool for Qt6
         find_package(Qt6 REQUIRED COMPONENTS ShaderTools)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index a8ed5d7..aa2f9e5 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -510,11 +510,18 @@ target_include_directories(${target}
     INTERFACE
         $<INSTALL_INTERFACE:${QSK_INSTALL_HEADERS}>)
 
-target_link_libraries(${target}
-    PUBLIC Qt::Core Qt::CorePrivate Qt::Quick Qt::QuickPrivate)
-
-if (QT_VERSION_MAJOR VERSION_GREATER 5)
-    target_link_libraries(${target} PUBLIC Qt::OpenGL Qt::OpenGLPrivate)
+if(QT_VERSION_MAJOR EQUAL 6)
+    target_link_libraries(${target}
+        PUBLIC Qt6::Core Qt6::CorePrivate Qt6::Quick Qt6::QuickPrivate)
+    if (QT_VERSION_MAJOR VERSION_GREATER 5)
+        target_link_libraries(${target} PUBLIC Qt6::OpenGL Qt6::OpenGLPrivate)
+    endif()
+else()
+    target_link_libraries(${target}
+        PUBLIC Qt::Core Qt::CorePrivate Qt::Quick Qt::QuickPrivate)
+    if (QT_VERSION_MAJOR VERSION_GREATER 5)
+        target_link_libraries(${target} PUBLIC Qt::OpenGL Qt::OpenGLPrivate)
+    endif()
 endif()
 
 if(ENABLE_HUNSPELL)
